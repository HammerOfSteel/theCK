# ============================================
# The CK: Amelia  .gitignore
# ============================================

# ----- Ren'Py compiled / generated files -----
*.rpyc
*.rpymc
*.rpyb

# ----- Ren'Py cache -----
**/cache/
**/game/cache/

# ----- Ren'Py saves & persistent data -----
**/saves/
**/game/saves/

# ----- Ren'Py logs & error files -----
log.txt
errors.txt
traceback.txt
**/log.txt
**/errors.txt
**/traceback.txt

# ----- Ren'Py build distributions -----
TheCK-*-dists/
*-dists/

# ----- Large media files (not in repo) -----
*.mp3
*.mp4
*.webm
*.ogg
*.wav
*.flac

# ----- OS junk -----
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# ----- IDE / Editor -----
.vscode/
*.code-workspace
