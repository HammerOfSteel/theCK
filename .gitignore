# ============================================
# The CK: Amelia  .gitignore
# ============================================

# ----- Ren'Py compiled / generated files -----
*.rpyc
*.rpymc
*.rpyb

# ----- Ren'Py cache -----
**/cache/
**/game/cache/

# ----- Ren'Py saves & persistent data -----
**/saves/
**/game/saves/

# ----- Ren'Py logs & error files -----
log.txt
errors.txt
traceback.txt
**/log.txt
**/errors.txt
**/traceback.txt

# ----- Ren'Py build distributions -----
TheCK-*-dists/
*-dists/

# ----- Ren'Py SDK (local installations) -----
renpy-*-sdk/
renpy-sdk/

# ----- Large media files (originals / uncompressed) -----
*.wav
*.flac
*.mp3

# ----- OS junk -----
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# ----- IDE / Editor -----
.vscode/
*.code-workspace

# ----- Python virtual environments -----
tools/venv/
tools/sdxl_venv/
.venv/

# ----- Python caches -----
**/__pycache__/
*.pyc

# ----- Amelia Studio (tools/studio) runtime & secrets -----
tools/studio/output/          # runtime DB, uploads, generated voice/images
tools/studio/.env             # contains FAL_KEY and other secrets
tools/.studio_pids.json       # running-process PIDs
tools/sdxl_server.log         # local SDXL server log
# keep env templates in the repo
!**/.env.example

